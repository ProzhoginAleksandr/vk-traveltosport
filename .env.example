# === VK Mini Apps: автодеплой ===
#
# Токен можно оставить пустым: при первом `npm run deploy` vk-miniapps-deploy
# сам проведёт авторизацию и запомнит токен. Либо вставьте access_token,
# полученный в карточке приложения на dev.vk.ru.
# (файл .env добавлен в .gitignore — не коммитьте токен)
MINI_APPS_ACCESS_TOKEN=

# Окружение:
#   dev        — только dev-окружение (обычно БЕЗ подтверждения телефона)
#   production — production (+ dev); VK может запросить подтверждение
#   both       — оба окружения (по умолчанию both)
MINI_APPS_ENVIRONMENT=dev

# Неинтерактивный режим (CI) и обновление URL задаются не здесь, а полями
# в vk-hosting-config.json:
#   "noprompt": true      — деплой без вопросов; update_prod/update_dev
#                           берутся из того же файла (сейчас 1 / 1)
#   "update_prod"/"update_dev" — обновлять ли URL окружений (1 — да, 0 — нет)
# vk-miniapps-deploy v1.0.2 читает из окружения только MINI_APPS_ACCESS_TOKEN,
# MINI_APPS_ENVIRONMENT и MINI_APPS_APP_ID.

# Переопределение app_id из vk-hosting-config.json
#MINI_APPS_APP_ID=54647551