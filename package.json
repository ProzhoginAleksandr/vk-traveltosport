{
  "name": "traveltosport",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "node build.cjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tunnel": "vk-tunnel --http-protocol=http --host=localhost --port=5173",
    "deploy": "node build.cjs && node deploy.cjs both",
    "deploy:dev": "node build.cjs && node deploy.cjs dev",
    "deploy:prod": "node build.cjs && node deploy.cjs production"
  },
  "dependencies": {
    "@vkontakte/icons": "^3.1.1",
    "@vkontakte/vk-bridge": "^2.15.12",
    "@vkontakte/vk-bridge-react": "^1.0.1",
    "@vkontakte/vk-mini-apps-router": "^1.8.6",
    "@vkontakte/vkui": "^7.0.0",
    "maplibre-gl": "^6.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vkontakte/vk-miniapps-deploy": "^1.0.2",
    "@vkontakte/vk-tunnel": "^0.2.4",
    "eruda": "^3.0.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.20.2": true,
    "esbuild@0.21.5": true,
    "@vkontakte/vk-bridge@2.15.12": true,
    "@vkontakte/vk-bridge-react@1.1.3": true,
    "@vkontakte/vk-miniapps-deploy@1.0.2": true,
    "core-js@3.49.0": true
  }
}
