{
  "name": "traveltosport",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "tunnel": "vk-tunnel --http-protocol=http --host=localhost --port=5173",
    "token": "node get-token.cjs",
    "token:new": "node get-token.cjs --force",
    "token:print": "node get-token.cjs --print",
    "deploy": "vite build && node deploy.cjs both",
    "deploy:dev": "vite build && node deploy.cjs dev",
    "deploy:prod": "vite build && node deploy.cjs production"
  },
  "dependencies": {
    "@vkontakte/icons": "^3.1.1",
    "@vkontakte/vk-bridge": "^2.15.12",
    "@vkontakte/vk-bridge-react": "^1.0.1",
    "@vkontakte/vk-mini-apps-router": "^1.8.6",
    "@vkontakte/vkui": "^7.0.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-legacy": "^5.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vkontakte/vk-miniapps-deploy": "^1.0.2",
    "@vkontakte/vk-tunnel": "^0.2.4",
    "configstore": "^5.0.1",
    "eruda": "^3.0.1",
    "esbuild": "~0.20.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "terser": "^5.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "zip-a-folder": "^0.0.12"
  },
  "allowScripts": {
    "esbuild@0.20.2": true,
    "esbuild@0.21.5": true,
    "@vkontakte/vk-bridge@2.15.12": true,
    "@vkontakte/vk-bridge-react@1.1.3": true,
    "@vkontakte/vk-miniapps-deploy@1.0.2": true,
    "core-js@3.49.0": true
  }
}
